{
  "name": "iwe",
  "displayName": "IWE: Markdown Knowledge Base",
  "description": "Markdown knowledge base you and your AI agent work on together: links, backlinks, search and refactoring for notes in VS Code.",
  "version": "0.0.5",
  "license": "MIT",
  "icon": "assets/logo.png",
  "publisher": "IWE",
  "homepage": "https://iwe.md/docs/editors/vscode/",
  "repository": "https://github.com/iwe-org/iwe",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "workspaceContains:.iwe/config.toml"
  ],
  "keywords": [
    "markdown",
    "pkm",
    "lsp",
    "note",
    "notes",
    "link",
    "links",
    "references",
    "zettelkasten"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "iwe.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "IWE"
      },
      {
        "command": "iwe.updateLanguageServer",
        "title": "Update Language Server",
        "category": "IWE"
      },
      {
        "command": "iwe.showOutput",
        "title": "Show Output",
        "category": "IWE"
      }
    ],
    "configuration": {
      "title": "IWE",
      "properties": {
        "iwe.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to an `iwes` binary. When empty, the extension uses `iwes` from `PATH` or downloads the latest release."
        },
        "iwe.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check for language server updates"
        },
        "iwe.updateCheckInterval": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "description": "Hours between automatic update checks"
        },
        "iwe.debug": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Start the language server with `IWE_DEBUG` set, which writes a detailed `iwe.log` to the workspace folder."
        },
        "iwe.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the IWE language server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "publish": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.96.0",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.14.0",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "dependencies": {
    "tar": "^7.5.22",
    "vscode-languageclient": "^11.0.0",
    "yauzl": "^3.4.0"
  }
}
